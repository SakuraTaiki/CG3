mtllib bone_line.mtl
o DebugBone

# The local X axis runs from the parent joint (-0.5) to the child
# joint (+0.5).  The diamond widens near the parent like a common
# DCC skeleton display, making hierarchy direction easy to read.
v -0.500  0.000  0.000
v -0.300  0.500  0.000
v -0.300  0.000  0.500
v -0.300 -0.500  0.000
v -0.300  0.000 -0.500
v  0.500  0.000  0.000

usemtl BoneMaterial

# Parent cap
f 1 2 3
f 1 3 4
f 1 4 5
f 1 5 2

# Taper toward the child joint
f 6 3 2
f 6 4 3
f 6 5 4
f 6 2 5
